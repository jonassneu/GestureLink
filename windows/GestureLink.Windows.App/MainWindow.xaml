<Window x:Class="GestureLink.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestureLink" Height="650" Width="560" MinHeight="600" MinWidth="520"
        Background="#07111F" WindowStartupLocation="CenterScreen">
  <Grid Margin="36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel HorizontalAlignment="Center">
      <TextBlock Text="GestureLink" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock Text="QR scannen – fertig." Foreground="#AFC4DA" FontSize="18" Margin="0,8,0,0" HorizontalAlignment="Center"/>
    </StackPanel>

    <Border Grid.Row="1" Background="White" CornerRadius="24" Padding="20" Margin="0,28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="{Binding PairingQr}" Width="390" Height="390" Stretch="Uniform"/>
    </Border>

    <Border Grid.Row="2" Background="#17304A" CornerRadius="18" Padding="18,12" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding StateLabel}" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
    </Border>
  </Grid>
</Window>
