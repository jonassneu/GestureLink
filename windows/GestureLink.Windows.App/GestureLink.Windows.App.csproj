<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- The hackathon PC enforces an Application Control rule that blocks unsigned sibling DLLs.
         Compile the clean Core source boundary into the desktop executable while keeping the
         independently buildable Core project for CI and reuse. -->
    <Compile Include="..\GestureLink.Windows.Core\**\*.cs" Exclude="..\GestureLink.Windows.Core\bin\**;..\GestureLink.Windows.Core\obj\**" LinkBase="Core" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>
</Project>
